# Copy to server/.env (server) — never commit the filled-in file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

RESEND_API_KEY=
EMAIL_FROM=

JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

REDIS_URL=
# Proxy hops in front of the server (Render = 1), or an IP/CIDR list.
TRUST_PROXY=1
# Production only. Same value in Vercel (sent on the /api rewrite) and Render (checked). Unset = no check.
ORIGIN_SECRET=
# Shared with the GitHub Actions secret of the same name (production) or your local curl (dev).
CRON_SECRET=

APP_URL=http://localhost:5173
BUSINESS_TZ=America/New_York
DEMO_MODE=true

# Tests only: set RUN_REDIS_INTEGRATION=1 to run the real-Redis test against TEST_REDIS_URL
# (a separate test database, never the production REDIS_URL).
RUN_REDIS_INTEGRATION=
TEST_REDIS_URL=

# Client (Vercel env, build time). Where the socket connects in production; unset in dev (Vite proxy).
VITE_SOCKET_URL=
